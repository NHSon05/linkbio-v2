// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BioPage > matches the classic starter snapshot 1`] = `"<div data-template="classic" data-desktop="center" style="--bio-accent:#CBD77E;--bio-radius:28px;--bio-button-radius:999px;--bio-surface:#ffffff;--bio-muted:rgb(40 40 40 / 0.6);background:#F7F7F7;color:#282828;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:gap-8 @5xl:px-10 @5xl:max-w-3xl"><header class="grid justify-items-center gap-2 text-center"><span aria-hidden="true" class="grid size-20 place-items-center rounded-full bg-(--bio-accent) text-2xl font-semibold text-[#282828]">T</span><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Tên của bạn</h1><p class="text-sm text-(--bio-muted)">Giới thiệu ngắn về bạn</p></header><div data-region="hero" class="grid gap-3"><div class="relative block overflow-hidden rounded-(--bio-radius) bg-(--bio-accent) px-5 py-6 text-[#282828]"><span class="relative block text-lg leading-snug font-semibold">Chào mừng bạn ghé trang của mình</span><span class="relative mt-1 block text-sm">Sửa dòng này trong Nội dung trang</span></div></div><div data-region="main" class="grid gap-3 @5xl:grid-cols-2"><a href="https://example.com/" data-block-id="b-link-1" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Website của mình</a><a href="https://example.com/contact" data-block-id="b-link-2" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Liên hệ hợp tác</a><div class="block overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-4"><strong class="block text-sm font-semibold">Bài viết nổi bật</strong><span class="mt-1 block text-xs text-(--bio-muted)">Thay bằng nội dung bạn muốn giới thiệu</span></span></div></div><div data-region="footer" class="grid gap-3"><a href="https://example.com/" data-block-id="b-foot" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Theo dõi mình</a></div></div></div>"`;

exports[`BioPage > matches the shop-grid starter snapshot 1`] = `"<div data-template="shop-grid" data-desktop="grid" style="--bio-accent:#E6CA9A;--bio-radius:20px;--bio-button-radius:16px;--bio-surface:#ffffff;--bio-muted:rgb(40 40 40 / 0.6);background:#F7F7F7;color:#282828;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:gap-8 @5xl:px-10 @5xl:max-w-6xl"><header class="grid justify-items-center gap-2 text-center"><span aria-hidden="true" class="grid size-20 place-items-center rounded-full bg-(--bio-accent) text-2xl font-semibold text-[#282828]">T</span><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Tên shop</h1><p class="text-sm text-(--bio-muted)">Sản phẩm mình chọn lọc</p></header><div data-region="hero" class="grid gap-3"><div class="relative block overflow-hidden rounded-(--bio-radius) bg-(--bio-accent) px-5 py-6 text-[#282828]"><span class="relative block text-lg leading-snug font-semibold">Ưu đãi tuần này</span><span class="relative mt-1 block text-sm">Nhập mã của bạn ở đây</span></div></div><div data-region="main" class="grid gap-3 grid-cols-2 @5xl:grid-cols-3"><section class="col-span-full grid gap-3"><h2 class="text-base font-semibold">Đồ mình hay dùng</h2><p class="rounded-(--bio-radius) bg-(--bio-surface) p-4 text-center text-xs text-(--bio-muted)">Chưa có sản phẩm</p></section><div class="block overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-4"><strong class="block text-sm font-semibold">Review mới</strong><span class="mt-1 block text-xs text-(--bio-muted)">Mô tả ngắn</span></span></div><a href="https://example.com/" data-block-id="b-link-1" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Shop chính thức</a></div><div data-region="footer" class="grid gap-3"><a href="https://example.com/" data-block-id="b-foot" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Chat với mình</a></div></div></div>"`;

exports[`BioPage > matches the video-first starter snapshot 1`] = `"<div data-template="video-first" data-desktop="split" style="--bio-accent:#CBD77E;--bio-radius:24px;--bio-button-radius:999px;--bio-surface:rgb(255 255 255 / 0.08);--bio-muted:rgb(247 247 247 / 0.65);background:#282828;color:#F7F7F7;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:max-w-6xl @5xl:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] @5xl:items-start @5xl:gap-10 @5xl:px-10"><div class="grid gap-5 @5xl:sticky @5xl:top-8"><header class="grid justify-items-center gap-2 text-center"><span aria-hidden="true" class="grid size-20 place-items-center rounded-full bg-(--bio-accent) text-2xl font-semibold text-[#282828]">T</span><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Tên kênh</h1><p class="text-sm text-(--bio-muted)">Video mới mỗi tuần</p></header><div data-region="hero" class="grid gap-3"><figure class="overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><div class="grid aspect-video place-items-center p-4 text-center text-xs text-(--bio-muted)">Dán link YouTube hoặc TikTok để hiện video</div><figcaption class="px-4 py-3 text-sm font-semibold">Video mới nhất</figcaption></figure></div></div><div class="grid gap-5"><div data-region="main" class="-mx-5 flex snap-x gap-3 overflow-x-auto px-5 pb-1 scrollbar-none *:w-[78%] *:shrink-0 *:snap-start @5xl:*:w-[calc(50%-0.375rem)]"><div class="block overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-4"><strong class="block text-sm font-semibold">Series nổi bật</strong><span class="mt-1 block text-xs text-(--bio-muted)">Mô tả ngắn</span></span></div><div class="block overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-4"><strong class="block text-sm font-semibold">Hậu trường</strong><span class="mt-1 block text-xs text-(--bio-muted)">Mô tả ngắn</span></span></div><a href="https://youtube.com/" data-block-id="b-link-1" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Kênh YouTube</a></div><div data-region="footer" class="grid gap-3"><a href="https://example.com/contact" data-block-id="b-foot" target="_blank" rel="noopener noreferrer nofollow" class="block rounded-(--bio-button-radius) bg-(--bio-accent) px-5 py-3.5 text-center text-sm font-semibold text-[#282828]">Liên hệ hợp tác</a></div></div></div></div>"`;

exports[`catalog categories (V2-31a) > links the root page to each top-level category 1`] = `"<div data-template="classic" data-desktop="center" style="--bio-accent:#CBD77E;--bio-radius:28px;--bio-button-radius:999px;--bio-surface:#ffffff;--bio-muted:rgb(40 40 40 / 0.6);background:#F7F7F7;color:#282828;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:gap-8 @5xl:px-10 @5xl:max-w-3xl"><header class="grid justify-items-center gap-2 text-center"><span aria-hidden="true" class="grid size-20 place-items-center rounded-full bg-(--bio-accent) text-2xl font-semibold text-[#282828]">S</span><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Son Shop</h1></header><nav aria-label="Danh mục" class="grid gap-3"><h2 class="text-base font-semibold">Danh mục</h2><ul class="flex flex-wrap gap-2"><li><a class="block rounded-(--bio-button-radius) bg-(--bio-surface) px-4 py-2 text-sm font-medium" href="/son-shop/lam-dep">Làm đẹp</a></li><li><a class="block rounded-(--bio-button-radius) bg-(--bio-surface) px-4 py-2 text-sm font-medium" href="/son-shop/trong">Trống</a></li></ul></nav></div></div>"`;

exports[`catalog categories (V2-31a) > renders a category with breadcrumbs, subcategories and its products 1`] = `"<link rel="preload" as="image" href="https://cf.shopee.vn/p1.jpg"/><div data-template="classic" data-desktop="center" style="--bio-accent:#CBD77E;--bio-radius:28px;--bio-button-radius:999px;--bio-surface:#ffffff;--bio-muted:rgb(40 40 40 / 0.6);background:#F7F7F7;color:#282828;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:gap-8 @5xl:px-10 @5xl:max-w-3xl"><header><a class="flex w-fit items-center gap-3" href="/son-shop"><span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-(--bio-accent) text-sm font-semibold text-[#282828]">S</span><span class="text-sm font-semibold">Son Shop</span></a></header><nav aria-label="Breadcrumb"><ol class="flex flex-wrap items-center gap-1.5 text-xs"><li class="flex items-center gap-1.5"><a class="text-(--bio-muted)" href="/son-shop">Son Shop</a></li><li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-(--bio-muted)">/</span><a aria-current="page" class="font-semibold" href="/son-shop/lam-dep">Làm đẹp</a></li></ol></nav><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Làm đẹp</h1><nav aria-label="Danh mục con" class="grid gap-3"><h2 class="text-base font-semibold">Danh mục con</h2><ul class="flex flex-wrap gap-2"><li><a class="block rounded-(--bio-button-radius) bg-(--bio-surface) px-4 py-2 text-sm font-medium" href="/son-shop/lam-dep/son">Son môi</a></li></ul></nav><ul class="grid grid-cols-2 gap-3 @5xl:grid-cols-4"><li><a href="https://s.shopee.vn/aff1" data-block-id="p1" target="_blank" rel="noopener noreferrer nofollow" class="block h-full overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><img alt="" src="https://cf.shopee.vn/p1.jpg" class="aspect-square w-full bg-white object-contain p-3"/><span class="block p-3"><span class="line-clamp-2 block text-xs font-semibold">Son kem</span></span></a></li><li><a href="https://shopee.vn/p2" data-block-id="p2" target="_blank" rel="noopener noreferrer nofollow" class="block h-full overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-3"><span class="line-clamp-2 block text-xs font-semibold">Son thỏi</span></span></a></li></ul></div></div>"`;

exports[`catalog categories (V2-31a) > renders a subcategory with the full breadcrumb trail 1`] = `"<div data-template="classic" data-desktop="center" style="--bio-accent:#CBD77E;--bio-radius:28px;--bio-button-radius:999px;--bio-surface:#ffffff;--bio-muted:rgb(40 40 40 / 0.6);background:#F7F7F7;color:#282828;font-family:&quot;Sora&quot;, var(--font-sora), system-ui, sans-serif" class="@container min-h-full w-full"><div class="mx-auto grid max-w-md gap-5 px-5 pt-8 pb-12 @5xl:gap-8 @5xl:px-10 @5xl:max-w-3xl"><header><a class="flex w-fit items-center gap-3" href="/son-shop"><span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-(--bio-accent) text-sm font-semibold text-[#282828]">S</span><span class="text-sm font-semibold">Son Shop</span></a></header><nav aria-label="Breadcrumb"><ol class="flex flex-wrap items-center gap-1.5 text-xs"><li class="flex items-center gap-1.5"><a class="text-(--bio-muted)" href="/son-shop">Son Shop</a></li><li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-(--bio-muted)">/</span><a class="text-(--bio-muted)" href="/son-shop/lam-dep">Làm đẹp</a></li><li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-(--bio-muted)">/</span><a aria-current="page" class="font-semibold" href="/son-shop/lam-dep/son">Son môi</a></li></ol></nav><h1 class="text-xl font-semibold tracking-tight @5xl:text-3xl">Son môi</h1><ul class="grid grid-cols-2 gap-3 @5xl:grid-cols-4"><li><a href="https://shopee.vn/p2" data-block-id="p2" target="_blank" rel="noopener noreferrer nofollow" class="block h-full overflow-hidden rounded-(--bio-radius) bg-(--bio-surface)"><span class="block p-3"><span class="line-clamp-2 block text-xs font-semibold">Son thỏi</span></span></a></li></ul></div></div>"`;
